{{!
    @template mod_crucible/form

    This template renders a url in an iframe of given size.

            Example context (json):
            {
	            "eventtemplate": "guid",
		          "url": "url"
            }
}}
<div class="crucible-controls d-inline-flex flex-wrap align-items-center gap-2 mb-3">
  <form id="lab_form" action="{{url}}" method="post" class="m-0 d-inline-block">
      <input id="event" type="hidden" name="event" value="" />
      <input id="eventtemplateid" type="hidden" name="eventtemplateid" value="{{eventtemplateid}}" />
      <input id="start_confirmed" type="hidden" name="start_confirmed" value="" />
      <input id="stop_confirmed" type="hidden" name="stop_confirmed" value="" />
      <input id="launch_button" style="display:inline-block" class="btn btn-primary" type="submit" name="start" value="Launch Lab" />
      <input id="end_button" style="display:none" class="btn btn-danger" type="submit" name="stop" value="End Lab"
          {{#joinedattempt}}disabled="disabled"{{/joinedattempt}} />
  </form>
  {{#isinstructor}}
  <a href="{{bulkdeployurl}}" class="btn btn-secondary" role="button">
      Manage Deployments
  </a>
  {{/isinstructor}}

  {{#extend}}
  <button id="extend-event" style="display:none;" class="btn btn-primary" type="button">{{extend}}</button>
  {{/extend}}

  <button id="wait"
        style="display:none; white-space:nowrap;"
        class="btn btn-primary text-start"
        type="button"
        name="wait">
    <span class="spinner-border spinner-border-sm" role="status"></span>
    &nbsp;&nbsp;<span id="wait-text">Please wait, system processing…</span>
    </button>

    <input id="failed"
        style="display:none; white-space:nowrap;"
        class="btn btn-secondary"
        type="button"
        name="failed"
        value="Your operation has failed." />

  <button id="enable-fullscreen" style="display:none;" type="button" class="btn btn-primary">{{fullscreen}}</button>

   {{#code}}
    <input id="invitationlinkurl"
           type="text"
           value="{{url}}&code={{code}}"
           readonly
           style="position: absolute; left: -9999px;">

    <button id="copy_invite" type="button" class="btn btn-primary" style="display:none;">
        <i class="icon fa fa-copy fa-fw" aria-hidden="true"></i>
        Copy Invitation Link
    </button>
  {{/code}}

  {{^joinedattempt}}
    {{#activeattempts}}
    <form id="join-form" action="" method="get" style="display:none" class="m-0">
      <div class="input-group d-inline-flex flex-nowrap w-auto">
        <input type="hidden" name="id" value="{{id}}" />
        <label for="attempt" class="input-group-text text-nowrap">Join Existing Lab</label>
        <select name="attempt" id="attempt" class="form-select w-auto">
          {{#attempts}}
              <option value="{{id}}">{{username}}</option>
          {{/attempts}}
        </select>
        <input type="submit" class="btn btn-primary" value="Join">
      </div>
    </form>
    {{/activeattempts}}
  {{/joinedattempt}}
</div>

{{#joinedattempt}}
<p class="crucible-attempt-owner w-100 mb-2 text-muted">
  Viewing attempt owned by: <span class="fw-semibold text-body">{{joinedattemptowner}}</span>
</p>
<div class="crucible-attempt-switcher d-flex flex-wrap align-items-center gap-2 w-100 mb-3">
  <form action="{{url}}" method="get" class="m-0">
    <input type="hidden" name="id" value="{{id}}" />
    <input id="return-button" type="submit" style="display:none" class="btn btn-primary" value="Return">
  </form>
  {{#activeattempts}}
  <form id="join-form" action="" method="get" style="display:none" class="m-0 d-inline-block">
    <div class="input-group d-inline-flex flex-nowrap w-auto">
      <input type="hidden" name="id" value="{{id}}" />
      <label for="attempt" class="input-group-text text-nowrap">Join Existing Lab</label>
      <select name="attempt" id="attempt" class="form-select w-auto">
        {{#attempts}}
            <option value="{{id}}">{{username}}</option>
        {{/attempts}}
      </select>
      <input type="submit" class="btn btn-primary" value="Join">
    </div>
  </form>
  {{/activeattempts}}
</div>
{{/joinedattempt}}

{{#js}}
require(['mod_crucible/formconfirm'], function(FormConfirm) {
    FormConfirm.init();
});
{{/js}}
