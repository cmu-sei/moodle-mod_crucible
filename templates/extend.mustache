{{!
    @template mod_crucible/extend

    Instructor-only panel for extending the active event duration.

    Example context (json):
    {
        "eventid": "abc-123",
        "cmid": 1,
        "extendlabel": "Extend Event",
        "durationlabel": "Duration",
        "hourslabel": "Hours",
        "minuteslabel": "Minutes",
        "sesskey": "xyz"
    }
}}

<div class="extend-panel card mt-3 mb-3">
    <div class="card-body">
        <h5 class="card-title">{{extendlabel}}{{#activityname}} — {{activityname}}{{/activityname}}</h5>
        <div class="form-inline">
            <label for="extend-hours-{{eventid}}" class="mr-2">{{hourslabel}}</label>
            <input type="number" id="extend-hours-{{eventid}}" class="form-control mr-2" value="1" min="0" max="168" step="1" style="width: 80px;">
            <label for="extend-minutes-{{eventid}}" class="mr-2">{{minuteslabel}}</label>
            <input type="number" id="extend-minutes-{{eventid}}" class="form-control mr-2" value="0" min="0" max="59" step="1" style="width: 80px;">
            <button class="btn btn-primary extend-event-btn" data-eventid="{{eventid}}" data-cmid="{{cmid}}" data-sesskey="{{sesskey}}">{{extendlabel}}</button>
        </div>
    </div>
</div>
